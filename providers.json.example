{
  "__README": [
    "Extra models for the bridge. Rename to providers.json to activate.",
    "NEVER put an API key in this file. 'env' names the ENVIRONMENT VARIABLE that",
    "holds the key; the key itself stays in .env or your shell. The bridge refuses",
    "any entry whose 'env' looks like a key.",
    "Almost every hosted model speaks the OpenAI chat-completions shape, so most",
    "entries only need: key, label, env, base, model."
  ],
  "providers": [
    { "key": "gpt", "label": "GPT (OpenAI)", "env": "OPENAI_API_KEY", "base": "https://api.openai.com/v1", "path": "/chat/completions", "model": "gpt-5", "style": "openai" },
    { "key": "gemini_or", "label": "Gemini 3.7 Flash (OpenRouter)", "env": "OPENROUTER_API_KEY", "base": "https://openrouter.ai/api/v1", "model": "google/gemini-3.7-flash", "style": "openai",
      "_note": "Slug verified against OpenRouter's live model list on 2026-08-29. The old 'google/gemini-3-pro' was never a valid ID and 400'd. Check https://openrouter.ai/api/v1/models before pinning any slug — alpha/stealth names change." },
    { "key": "llama_groq", "label": "Llama (Groq)", "env": "GROQ_API_KEY", "base": "https://api.groq.com/openai/v1", "model": "llama-4-70b", "style": "openai" },
    { "key": "local", "label": "Local (Ollama)", "env": null, "base": "http://127.0.0.1:11434/v1", "model": "qwen3:32b", "style": "openai" },
    { "key": "opus", "label": "Claude Opus 5 (OpenRouter)", "env": "OPENROUTER_API_KEY", "model": "anthropic/claude-opus-5", "style": "anthropic", "base": "https://openrouter.ai/api/v1", "path": "/chat/completions",
      "_note": "This entry routes through OpenRouter, so the key is OPENROUTER_API_KEY. It previously named ANTHROPIC_API_KEY while pointing at OpenRouter — a combination that can never authenticate. For the direct Anthropic API use base https://api.anthropic.com, style anthropic, env ANTHROPIC_API_KEY." },
    { "key": "glm", "label": "GLM-5.3-Flash (OpenRouter)", "model": "z-ai/glm-5.3-flash", "base": "https://openrouter.ai/api/v1", "path": "/chat/completions", "env": "OPENROUTER_API_KEY", "style": "openai",
      "_note": "PROBED WORKING 2026-08-29 with NO thinking config: finish_reason stop, clean JSON in content, reasoning also returned in message.reasoning. Do NOT set thinking here — OpenRouter handles it. The thinking/token_floor settings matter for the DIRECT Z.AI endpoint (glm_zai), not this one." },
    { "key": "glm_zai", "label": "GLM-5.3-Flash (direct Z.AI)", "model": "glm-5.3-flash", "base": "https://api.z.ai/api/paas/v4", "path": "/chat/completions", "env": "ZAI_API_KEY", "style": "openai", "thinking": "enabled", "token_floor": 16000,
      "_note": "Direct to Z.AI the native param applies: thinking:{type:'enabled', clear_thinking:false}. Docs: thinking.type only supports 'enabled'. Text arrives in message.reasoning_content." },
    { "key": "kimi", "label": "Kimi K3 (Moonshot direct)", "model": "kimi-k3", "base": "https://api.moonshot.ai/v1", "path": "/chat/completions", "env": "MOONSHOT_API_KEY", "style": "openai", "temperature": 1,
      "_note": "Moonshot direct accepts ONLY temperature 1 — anything else is a hard 400. Via OpenRouter instead: model moonshotai/kimi-k3, base https://openrouter.ai/api/v1, env OPENROUTER_API_KEY." }
  ]
}
