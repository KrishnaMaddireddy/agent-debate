{
  "_comment": "Your model providers. Edit here or in Settings. Providers are OFF until \"enabled\": true \u2014 the server refuses any call to a provider you have not switched on, and only models listed here can be called, so nothing is billed by accident. type picks the adapter: anthropic | openai (any /chat/completions API) | gemini | cli (Claude Code CLI \u2014 your Claude subscription, no key) | mock. keyEnv names the variable in .env; keys never leave the server. Optional per provider: temperature, tokenFloor (minimum max_tokens \u2014 reasoning models think before they answer), timeoutMs (otherwise 2 min + 30 ms per token, max 10 min), thinking (enabled | disabled; dialect inferred from baseUrl), extraHeaders.",
  "default": {
    "provider": "mock",
    "model": "mock-1"
  },
  "providers": {
    "claude": {
      "label": "Claude (subscription via CLI)",
      "type": "cli",
      "command": "claude",
      "keyEnv": null,
      "models": [
        "sonnet",
        "opus",
        "haiku"
      ],
      "timeoutMs": 300000
    },
    "deepseek": {
      "label": "DeepSeek",
      "type": "openai",
      "baseUrl": "https://api.deepseek.com",
      "keyEnv": "DEEPSEEK_API_KEY",
      "models": [
        "deepseek-flash",
        "deepseek-v4-pro",
        "deepseek-chat"
      ],
      "tokenFloor": 4000
    },
    "moonshot": {
      "label": "Kimi (Moonshot)",
      "type": "openai",
      "baseUrl": "https://api.moonshot.ai/v1",
      "keyEnv": "MOONSHOT_API_KEY",
      "models": [
        "kimi-k3",
        "kimi-k2.6"
      ],
      "temperature": 1,
      "tokenFloor": 4000
    },
    "openrouter": {
      "label": "OpenRouter",
      "type": "openai",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "models": [
        "google/gemini-3.7-flash",
        "z-ai/glm-5.3-flash",
        "openai/gpt-5-mini",
        "anthropic/claude-sonnet-4.6"
      ],
      "tokenFloor": 4000,
      "extraHeaders": {
        "HTTP-Referer": "http://localhost:8787",
        "X-Title": "agent-debate"
      }
    },
    "anthropic": {
      "label": "Anthropic",
      "type": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "keyEnv": "ANTHROPIC_API_KEY",
      "models": [
        "claude-sonnet-4-6",
        "claude-opus-4-6",
        "claude-haiku-4-5"
      ]
    },
    "openai": {
      "label": "OpenAI",
      "type": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "keyEnv": "OPENAI_API_KEY",
      "models": [
        "gpt-5",
        "gpt-5-mini",
        "gpt-4.1"
      ]
    },
    "google": {
      "label": "Google Gemini",
      "type": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com",
      "keyEnv": "GEMINI_API_KEY",
      "models": [
        "gemini-2.5-pro",
        "gemini-2.5-flash"
      ]
    },
    "ollama": {
      "label": "Ollama (local)",
      "type": "openai",
      "baseUrl": "http://localhost:11434/v1",
      "keyEnv": null,
      "models": [
        "qwen3:32b",
        "llama3.1",
        "mistral"
      ]
    },
    "mock": {
      "label": "Mock",
      "type": "mock",
      "keyEnv": null,
      "models": [
        "mock-1",
        "mock-2",
        "mock-3",
        "mock-alt",
        "mock-liar",
        "mock-prose",
        "mock-reasoning",
        "mock-template",
        "mock-empty",
        "mock-fail",
        "mock-cot",
        "mock-greedy",
        "mock-dsml",
        "mock-slow",
        "mock-svg"
      ]
    }
  }
}
