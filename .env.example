# Copy to .env at the repo root (or local/.env). Only the providers you enable need a key.
# Never commit .env. Settings › Providers can write these for you; it never reads them back.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Tools. web_search uses the first backend below whose key is set; WEB_SEARCH_PROVIDER= forces one.
SERPEX_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARXNG_URL=
# The server binds to 127.0.0.1:8787 by default.
PORT=
